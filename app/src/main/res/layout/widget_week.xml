<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/ww_ring" android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="@string/widget_description" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/ww_steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F5F5F7" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_goal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#9AA0A6" android:textSize="11sp" />
            <TextView android:id="@+id/ww_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="1" android:textColor="#9AA0A6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/ww_bars" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:scaleType="fitXY" android:contentDescription="Steps this week" />
</LinearLayout>
